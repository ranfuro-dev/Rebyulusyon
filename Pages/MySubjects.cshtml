@page
@model MySubjectsModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Subjects";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="app-page">
    <div class="container">
        <p class="eyebrow">Your library</p>
        <h1 class="app-title">My Subjects</h1>
        <p class="app-sub">Organize your reviewers under the subjects you study.</p>

        <div class="app-empty">
            <h2>Add a subject</h2>

            <form method="post">
                <div class="form-field">
                    <label asp-for="Name">Subject name</label>
                    <input asp-for="Name" class="form-input" maxlength="100" required />
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-sm">Add subject</button>
            </form>
        </div>

        @if (Model.Subjects.Count == 0)
        {
            <div class="app-empty">
                <h2>No subjects yet</h2>
                <p>Add a subject above to start organizing your reviewers.</p>
            </div>
        }
        else
        {
            @* Each subject is a card that opens its reviewers and has its own delete action. *@
            <div class="subject-grid">
                @foreach (var subject in Model.Subjects)
                {
                    <article class="subject-card">
                        <a class="subject-card-link" href="/MyReviewers?subjectId=@subject.Id">
                            <span class="subject-icon tone-@subject.Tone"><partial name="_Icon" model='"folder"' /></span>
                            <span class="subject-card-copy">
                                <strong>@subject.Name</strong>
                                <span>View reviewers in this subject</span>
                            </span>
                            <span class="subject-card-arrow"><partial name="_Icon" model='"arrow"' /></span>
                        </a>

                        @* Ask before deleting a subject and everything organized under it. *@
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-subjectId="@subject.Id"
                              class="subject-delete-form"
                              onsubmit="return confirm('Are you sure you want to delete this subject? This will permanently delete its reviewers and flashcards too. This action cannot be undone.');">
                            <button type="submit"
                                    class="subject-delete-button"
                                    aria-label="Delete subject @subject.Name"
                                    title="Delete subject">
                                <partial name="_Icon" model='"trash"' />
                            </button>
                        </form>
                    </article>
                }
            </div>
        }
    </div>
</section>
