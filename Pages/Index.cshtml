@* The Home Page. @page makes this file a page that has its own web address ("/").
   NOTE: there is no @model line in Lesson 1 because we do not use C# data yet.
   We will add "@model IndexModel" back in Lesson 3. *@
@page

@{
    // This C# block sets the title used by the browser tab in _Layout.cshtml
    ViewData["Title"] = "Home";

    @* Connects this page to the IndexModel class in Index.cshtml.cs.
   This is what lets us write Model.Features below *@
    @model IndexModel
}

@* ===== HERO SECTION (the big opening area of the page) ===== *@
<section class="hero">

    @* "container" centers the content. "hero-grid" splits it into 2 columns (set in CSS) *@
    <div class="container hero-grid">

        @* ----- LEFT COLUMN: the text ----- *@
        <div class="hero-copy" data-reveal>

            @* The yellow badge at the top. "pill" = rounded capsule shape, "pill-yellow" = its color *@
            <span class="pill pill-red">
                <partial name="_Icon" model='"sparkles"' /> Para sa mga estudyanteng Pilipino
            </span>

            @* Small spaced-out blue tagline above the headline *@
            <p class="eyebrow">Rebyu Ngayon, Pasado Bukas.</p>

            @* The main headline. The span with class "accent" turns just "Revolutionize" blue *@
            <h1><span class="accent">Revolutionize</span> the way you review.</h1>

            @* The paragraph under the headline. "lead" makes it larger and gray *@
            <p class="lead">
                Rebyulusyon helps you build your own reviewers, organize them under subjects you create,
                and master them with flashcards — one focused session at a time.
            </p>

            @* The two buttons side by side.
               btn = shape, btn-lg = large, btn-primary = solid blue, btn-outline = white with a border *@
            <div class="btn-row">
                <a class="btn btn-primary btn-lg" href="/Register">
                    <partial name="_Icon" model='"zap"' /> Get Started Free
                </a>
                <a class="btn btn-outline btn-lg" href="/Reviewers">Explore Reviewers</a>
            </div>

            @* The stats strip. <dt> is the big word, <dd> is the small text under it *@
            <dl class="stats">
                <div><dt class="text-blue">Free</dt><dd>for students</dd></div>
                <div><dt class="text-red">5 min</dt><dd>to your first reviewer</dd></div>
                <div><dt class="text-ink">Mobile</dt><dd>ready anywhere</dd></div>
            </dl>
        </div>

        @* ----- RIGHT COLUMN: the picture and the floating card ----- *@
        <div class="hero-art" data-reveal data-delay="1">

            @* The illustration. ~/ means the wwwroot folder.
               alt is a text description for screen readers and for when the image fails to load *@
            <img class="art-card" src="~/images/flashcard.svg" alt="A stack of flashcards" />

            @* The "Today's Progress" card that floats over the bottom-left of the picture.
               TEMPORARY MOCK DATA: these numbers are typed by hand for now.
               Later they will come from the database. *@
            <div class="progress-card">
                <div class="progress-top">
                    <span>Today’s Progress</span>
                    <span class="pill pill-yellow pill-sm"><partial name="_Icon" model='"flame"' /> 7 days</span>
                </div>
                <strong class="progress-count">12 / 20 cards</strong>

                @* The progress bar: a gray track with a blue fill.
                   width: 60% is 12 out of 20 (12 ÷ 20 = 0.6) *@
                <div class="bar"><div class="bar-fill" style="width: 60%"></div></div>
            </div>
        </div>

    </div>
</section>

@* ===== FEATURES SECTION ("Everything in one place") ===== *@
<section class="features">
    <div class="container">

        @* The centered heading area above the cards *@
        <div class="section-head" data-reveal>
            @* Small blue label with a thin line on each side (the lines are drawn by CSS) *@
            <p class="eyebrow eyebrow-lines">Everything in one place</p>
            <h2>Built around how students actually review</h2>
            <p class="section-sub">
                No clutter, no noisy dashboards. Just the tools you need to prepare for the next quiz,
                finals or board exam.
            </p>
        </div>

        @* The grid that holds the six cards (3 columns on desktop) *@
        <div class="feature-grid">

            @* @foreach repeats the markup inside the braces once for EACH item in the list.
               "f" is the current item. Model.Features comes from Index.cshtml.cs *@
            @foreach (var f in Model.Features)
            {
                @* <article> is the HTML tag for a self-contained piece of content, like a card *@
                <article class="feature-card" data-reveal>

                    @* The round icon badge. "tone-@f.Tone" builds a class name like "tone-blue",
                       which the CSS uses to pick the badge color.
                       model="f.Icon" passes the icon name to _Icon.cshtml (no extra quotes,
                       because f.Icon is a C# value, not typed text) *@
                    <span class="icon-chip tone-@f.Tone"><partial name="_Icon" model="f.Icon" /></span>

                    @* @f.Title and @f.Description print the values from the list *@
                    <h3>@f.Title</h3>
                    <p>@f.Description</p>
                </article>
            }
        </div>
    </div>
</section>


@* ===== REVIEW ROUTINE SECTION ("From scattered notes to a review routine") ===== *@
<section class="routine">

    @* "routine-grid" splits the content into 2 columns: picture left, text right *@
    <div class="container routine-grid">

        @* LEFT: the illustration. "art-card" is the same rounded frame used in the hero *@
        <img class="art-card" src="~/images/book.svg" alt="An open book with a bookmark" data-reveal />

        @* RIGHT: heading, numbered steps, and a button *@
        <div class="routine-copy" data-reveal data-delay="1">

            @* The heading. <br /> forces a line break. The span turns "review routine" red *@
            <h2>From scattered notes<br />to a <span class="text-red">review routine</span></h2>

            @* <ol> is an "ordered list" of steps. "steps" is the class the CSS styles *@
            <ol class="steps">

                @* Repeats once for each Step in the C# list (Model.Steps) *@
                @foreach (var s in Model.Steps)
                {
                    <li>
                        @* The red numbered circle. @s.Number prints 1, 2, or 3 *@
                        <span class="step-num">@s.Number</span>

                        @* The title and description, stacked on top of each other *@
                        <div class="step-text">
                            <strong>@s.Title</strong>
                            <span>@s.Description</span>
                        </div>
                    </li>
                }
            </ol>

            @* The blue button that leads to the Register page (not built yet) *@
            <a class="btn btn-primary" href="/Register">Start your first reviewer</a>
        </div>

    </div>
</section>


@* ===== CLOSING SECTION: AI Study Tools card + blue banner ===== *@
<section class="closing">
    <div class="container">

        @* ----- THE AI STUDY TOOLS CARD (white box with 2 columns) ----- *@
        <div class="ai-card" data-reveal>

            @* LEFT: badge, heading, and paragraph *@
            <div>
                @* The "Coming Soon" badge. pill-yellow = yellow color, pill-sm = small size *@
                <span class="pill pill-yellow pill-sm">
                    <partial name="_Icon" model='"sparkles"' /> Coming Soon
                </span>
                <h2>AI Study Tools</h2>
                <p>
                    We are working on study tools that draft flashcards from your own notes and help explain
                    the answers you keep missing. Not available yet — but it is where Rebyulusyon is heading.
                </p>
            </div>

            @* RIGHT: the yellow checklist box. <ul> is an "unordered list" (bullets, removed by CSS) *@
            <ul class="ai-list">

                @* Repeats once for each text in the C# array (Model.AiTools).
                   "item" is the current text *@
                @foreach (var item in Model.AiTools)
                {
                    <li><partial name="_Icon" model='"check"' /> @item</li>
                }
            </ul>
        </div>

        @* ----- THE BLUE BANNER (call to action) ----- *@
        <div class="cta" data-reveal>
            <h2>Handa ka na bang mag-umpisa?</h2>
            <p>Gawin mong routine ang pag-review. Build your first reviewer today and keep the streak alive.</p>

            @* The two buttons. btn-white = white with blue text, btn-ghost = see-through with a white border.
               "center" centers the row (set in CSS) *@
            <div class="btn-row center">
                <a class="btn btn-white btn-lg" href="/Register">
                    <partial name="_Icon" model='"zap"' /> Get Started Free
                </a>
                <a class="btn btn-ghost btn-lg" href="/Reviewers">Explore Reviewers</a>
            </div>
        </div>

    </div>
</section>