@{
    // This is for finding out which page the visitor is on right now (for example "/Home" or "/About").
    // We use it to color the matching link in the top menu blue.
    // This line saves the name of the page that is open. If it cannot find one, it uses empty text.
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    // This is a small helper for the top menu links.
    // If the link belongs to the page that is open, it gives back "nav-link active" (a blue pill).
    // If not, it gives back only "nav-link" (plain gray text).
    string NavClass(string page) => currentPage == page ? "nav-link active" : "nav-link";
}
@* ============================================================
   This file is _Layout.cshtml.
   It is the frame that goes around EVERY page of the website.
   The top bar, the footer, the fonts, and the CSS and JavaScript files are set here once,
   so you do not have to copy them into each page.
   The content of each page (Home, About, Get Started...) goes where RenderBody() is below.
   ============================================================ *@
<!DOCTYPE html>
@* This tells the browser that this is a modern web page *@
<html lang="en">
@* This says the page is in English. It helps screen readers and translation tools *@
<head>
    @* This lets special letters like ñ and ’ show correctly *@
    <meta charset="utf-8" />

    @* This makes the page fit the real width of a phone screen. Without it, the page looks tiny on phones *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* This is for the text on the browser tab, for example "Home - Rebyulusyon".
       Each page sets its own title name, and it is placed here *@
    <title>@ViewData["Title"] - Rebyulusyon</title>

    @* This tells the page that JavaScript is working, by adding the word "js" to the page.
       The scroll animation in site.css only hides things when this word is there,
       so if JavaScript fails, nothing stays hidden *@
    <script>document.documentElement.classList.add("js");</script>

    @* These two lines connect to Google's font servers early, so the fonts load faster *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />

    @* This is for the website fonts:
       Fredoka (round letters) is used for headings and the logo,
       and Nunito (soft letters) is used for normal text.
       The numbers 400, 500, 600, and 700 are the letter thickness we load.
       display=swap shows the text right away in a backup font while the fonts load *@
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet" />

    @* This connects your own style file (wwwroot/css/site.css). It has all the colors, spacing, and layout.
       The ~ sign means the wwwroot folder.
       asp-append-version makes the browser load the newest copy after you change the file *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* This is a spot where a page can add its OWN style file.
       For example, the Explore Reviewers page uses it to load reviewers.css.
       Pages that do not need it simply leave this spot empty *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @* ---------- THE TOP BAR (stays at the top when you scroll down) ---------- *@
    <header class="site-header">

        @* "container" keeps the content in the middle and not too wide.
           "header-inner" puts the logo, the menu, and the buttons in one row *@
        <div class="container header-inner">

            @* LEFT SIDE: the Rebyulusyon logo. Clicking it goes to the Home page ("/") *@
            <a class="brand" href="/">
                @* This is for the blue square with the flashcard picture.
                   "partial" brings in the picture from _Icon.cshtml,
                   and "flashcard" tells it which picture to draw *@
                <span class="brand-mark"><partial name="_Icon" model='"flashcard"' /></span>

                @* The name and the small tagline. The CSS puts the tagline under the name *@
                <span class="brand-text">
                    @* The word "lusyon" is in its own span so it can be colored blue *@
                    <span class="brand-name">Rebyu<span class="accent">lusyon</span></span>
                    <span class="brand-tag">Rebyu. Tandaan. Pumasa.</span>
                </span>
            </a>

            @* MIDDLE: the menu links (Home, Explore Reviewers, About, and Dashboard for logged-in people).
               "nav" is the web page tag for a menu.
               NavClass(...) colors the link of the page you are on as a blue pill.
               This happens by itself, so you do not need to change it for each page *@
            <nav class="main-nav" aria-label="Main">
                @* This is for the Home link in the top menu *@
                <a class="@NavClass("/Home")" href="/">Home</a>
                @* This is for the "Explore Reviewers" link in the top menu *@
                <a class="@NavClass("/Reviewers")" href="/Reviewers">Explore Reviewers</a>
                @* This is for the About link in the top menu *@
                <a class="@NavClass("/About")" href="/About">About</a>

                @* CHANGED: This is for the Dashboard link in the top menu.
                   It only shows when the visitor is LOGGED IN. For everyone else the link is not on the page at all.
                   (Nobody can log in yet, because the real login is not built yet.) *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="@NavClass("/Dashboard")" href="/Dashboard">Dashboard</a>
                }
            </nav>

            @* RIGHT SIDE: the Log In link and the Get Started button *@
            <div class="header-actions">
                @* This is for the Log In link. It opens the Login page *@
                <a class="link-login" href="/Login">Log In</a>

                @* This is for the blue Get Started button. It opens the Get Started (Register) page.
                   btn = the button shape, btn-primary = the blue color, btn-sm = the small size.
                   "zap" is the lightning picture inside the button *@
                <a class="btn btn-primary btn-sm" href="/Register">
                    <partial name="_Icon" model='"zap"' /> Get Started
                </a>
            </div>

        </div>
    </header>

    @* ---------- THE MAIN PART OF THE PAGE ---------- *@
    <main>
        @* This is where the content of the open page appears
           (Home, About, Get Started, and so on).
           Everything else in this file stays the same on every page *@
        @RenderBody()
    </main>

    @* ---------- THE FOOTER (shows on every page because it is in this file) ---------- *@
    <footer class="site-footer">
        <div class="container">

            @* TOP ROW: the logo and short text on the left, three link lists on the right *@
            <div class="footer-top">

                @* LEFT: the logo, the short text, and three colored dots *@
                <div class="footer-brand">
                    @* The footer logo. Clicking it goes to the Home page *@
                    <a class="footer-logo" href="/">
                        @* This uses the same blue square from the top bar (the "brand-mark" style) *@
                        <span class="brand-mark"><partial name="_Icon" model='"flashcard"' /></span>
                        <span class="footer-logo-name">Rebyulusyon</span>
                    </a>
                    @* The short text under the footer logo *@
                    <p class="footer-tagline">
                        Rebyu. Tandaan. Pumasa. A study platform built for Filipino students who review with intent.
                    </p>

                    @* These are three small dots in the colors of the Philippine flag (blue, red, yellow).
                       The colors are set in site.css. They are only for decoration,
                       so "aria-hidden" tells screen readers to skip them *@
                    <div class="footer-dots" aria-hidden="true">
                        <span class="dot-blue"></span>
                        <span class="dot-red"></span>
                        <span class="dot-yellow"></span>
                    </div>
                </div>

                @* RIGHT: three lists of links (Platform, Company, Account).
                   The Contact page and the Login and Get Started pages are built.
                   Some of these pages may still show "not found" until they are built *@
                <nav class="footer-links" aria-label="Footer">
                    @* CHANGED: The "Platform" list now has only Home and Explore Reviewers.
                       The Dashboard and Progress links were removed *@
                    <div>
                        <h3>Platform</h3>
                        <a href="/">Home</a>
                        <a href="/Reviewers">Explore Reviewers</a>
                    </div>
                    @* The "Company" list *@
                    <div>
                        <h3>Company</h3>
                        <a href="/About">About</a>
                        <a href="/Contact">Contact</a>
                    </div>
                    @* The "Account" list *@
                    <div>
                        <h3>Account</h3>
                        <a href="/Login">Log In</a>
                        <a href="/Register">Get Started</a>
                    </div>
                </nav>
            </div>

            @* BOTTOM ROW: the copyright line under a thin line.
               DateTime.Now.Year shows the current year by itself, so you never have to update it *@
            <div class="footer-bottom">
                <p>© @DateTime.Now.Year Rebyulusyon. Gawa ng mga Pilipino, para sa mga estudyante.</p>
            </div>

        </div>
    </footer>

    @* This loads the JavaScript file (wwwroot/js/site.js).
       Right now it makes the scroll animation work (things fade in as you scroll down) *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* This is a spot where a page can add its OWN JavaScript file.
       The Get Started, Log In, Contact, Flashcard Study, and Dashboard pages use it.
       It comes after site.js, so site.js always loads first *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>