﻿@* ============================================================
   This file is _Icon.cshtml.
   It draws the small pictures (icons) used on the website.
   It is a "partial view", which means it is a small piece that other pages can use.
   To use it, write this in any page:  <partial name="_Icon" model='"zap"' />
   The word inside the quotes ("zap") is the name of the icon you want.
   If you add a new icon, add a new "case" below with its name.
   ============================================================ *@

@* This file receives one piece of information: the name of the icon, as text.
   Inside this file, that text is called "Model". *@
@model string

@* SVG is a picture made of code. It stays sharp at any size.
   viewBox="0 0 24 24" means every icon is drawn on a 24 by 24 grid.
   stroke="currentColor" means the lines use the same color as the text around the icon.
   So the same icon turns white inside a blue button, and blue on a light circle.
   fill="none" means the shapes are only outlines, not filled in.
   class="icon" connects it to the ".icon" style in site.css, which sets the size.
   aria-hidden="true" tells screen readers to skip the icon, because it is only a decoration. *@
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Model)
    {
        // "switch" looks at the icon name and draws only the icon that matches it.
        // Each "case" below is one icon.

        case "flashcard":
            // This is for the flashcard icon in the blue square of the logo (the top bar and the footer).
            // It shows two cards on top of each other, and the front card has two lines of text.
            <path d="M8 4h11a2 2 0 0 1 2 2v10" />
            <rect x="3" y="8" width="15" height="12" rx="2.5" />
            <path d="M7 13h7" />
            <path d="M7 16.5h4" />
            break;

        case "zap":
            // This is for the lightning bolt icon on the "Get Started" buttons
            // (the top bar, the hero, and the blue banner).
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            break;

        case "book":
            // This is for the open book icon. It is used on the "Create Your Own Reviewers" card on the Home page
            // and on the "Rebyu + Rebolusyon" card on the About page.
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            break;

        case "folder":
            // This is for the folder icon with a plus sign. It is used on the "Organize by Subject" card on the Home page.
            <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
            <path d="M12 10v6" />
            <path d="M9 13h6" />
            break;

        case "layers":
            // This is for the icon of stacked layers. It is used on the "Study With Flashcards" card on the Home page
            // and for the number of flashcards on the Explore Reviewers cards.
            <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z" />
            <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65" />
            <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65" />
            break;

        case "chart":
            // This is for the line chart icon. It is used on the "Track Your Progress" card on the Home page.
            <path d="M3 3v18h18" />
            <path d="m19 9-5 5-4-4-3 3" />
            break;

        case "flame":
            // This is for the flame icon. It is used on the "Build Study Streaks" card on the Home page
            // and on the small "7 days" badge of the progress card in the hero.
            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z" />
            break;

        case "target":
            // This is for the target icon (three circles). It is used on the "Set a Daily Goal" card on the Home page
            // and on the "Our Mission" card on the About page.
            <circle cx="12" cy="12" r="10" />
            <circle cx="12" cy="12" r="6" />
            <circle cx="12" cy="12" r="2" />
            break;

        case "sparkles":
            // This is for the sparkle icon. It is used on the red badge "Para sa mga estudyanteng Pilipino"
            // and on the yellow "Coming Soon" badge on the Home page.
            <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z" />
            break;

        case "check":
            // This is for the check mark icon. It is used in the yellow checklist box of the "AI Study Tools" card.
            <path d="M20 6 9 17l-5-5" />
            break;

        case "sun":
            // This is for the sun icon. It was the old logo icon. It is not used on any page now,
            // but it is kept here in case you want it back.
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            break;

        case "cap":
            // This is for the graduation cap icon. It is used on the "Students" card on the About page.
            <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
            <path d="M22 10v6" />
            <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
            break;

        case "users":
            // This is for the icon of two people. It is used on the "Study Groups" card on the About page.
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            break;

        case "bulb":
            // This is for the light bulb icon. It is used on the "Self-learners" card on the About page.
            <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
            <path d="M9 18h6" />
            <path d="M10 22h4" />
            break;

        case "calendar":
            // This is for the calendar icon with a check mark. It is used on the "Consistency beats cramming" card on the About page.
            <path d="M8 2v4" />
            <path d="M16 2v4" />
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M3 10h18" />
            <path d="m9 16 2 2 4-4" />
            break;

        case "help":
            // This is for the question mark icon inside a circle. It is used on the "Active recall works" card on the About page.
            <circle cx="12" cy="12" r="10" />
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
            <path d="M12 17h.01" />
            break;

        case "pencil":
            // This is for the pencil icon. It is used on the "Make it your own" card on the About page.
            <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
            <path d="m15 5 4 4" />
            break;

        case "trending":
            // This is for the arrow that goes up. It is used on the "Learning should feel good" card on the About page.
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
            <polyline points="16 7 22 7 22 13" />
            break;

        case "userplus":
            // This is for the icon of a person with a plus sign. It is used at the top of the Get Started (Register) page.
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <line x1="19" x2="19" y1="8" y2="14" />
            <line x1="22" x2="16" y1="11" y2="11" />
            break;

        case "login":
            // This is for the icon of an arrow going into a door. It is used at the top of the Log In page.
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" x2="3" y1="12" y2="12" />
            break;

        case "eye":
            // This is for the open eye icon. It is on the button that SHOWS the password.
            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" />
            <circle cx="12" cy="12" r="3" />
            break;

        case "eyeoff":
            // This is for the eye icon with a line through it. It is on the button that HIDES the password again.
            <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49" />
            <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242" />
            <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143" />
            <path d="m2 2 20 20" />
            break;

        case "mail":
            // This is for the envelope icon. It was used on the Contact page.
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            break;

        case "clock":
            // This is for the clock icon. It is used on the "Response time" card on the Contact page.
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
            break;

        case "send":
            // This is for the paper plane icon. It is used on the "Send message" button on the Contact page.
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
            break;

        case "search":
            // NEW: This is for the magnifying glass icon. It is used in the search bar and on the
            // "No reviewers found" message on the Explore Reviewers page.
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
            break;

        case "user":
            // NEW: This is for the icon of one person. It is used next to "Created by @username"
            // on the Explore Reviewers cards.
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
            break;

        case "arrow":
            // NEW: This is for the arrow that points to the right. It is used on the "Open Reviewer" button.
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
            break;

        case "dashboard":
            // This is for the icon of four boxes. It is used for "Dashboard" in the sidebar.
            <rect width="7" height="9" x="3" y="3" rx="1" />
            <rect width="7" height="5" x="14" y="3" rx="1" />
            <rect width="7" height="9" x="14" y="12" rx="1" />
            <rect width="7" height="5" x="3" y="16" rx="1" />
            break;

        case "settings":
            // This is for the icon of three sliders. It is used for "Settings" in the sidebar.
            <line x1="21" x2="14" y1="4" y2="4" />
            <line x1="10" x2="3" y1="4" y2="4" />
            <line x1="21" x2="12" y1="12" y2="12" />
            <line x1="8" x2="3" y1="12" y2="12" />
            <line x1="21" x2="16" y1="20" y2="20" />
            <line x1="12" x2="3" y1="20" y2="20" />
            <line x1="14" x2="14" y1="2" y2="6" />
            <line x1="8" x2="8" y1="10" y2="14" />
            <line x1="16" x2="16" y1="18" y2="22" />
            break;

        case "logout":
            // This is for the icon of an arrow going out of a door. It is used for "Log out".
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" x2="9" y1="12" y2="12" />
            break;

        case "menu":
            // This is for the icon of three lines. It is the button that opens the menu on phones.
            <line x1="4" x2="20" y1="12" y2="12" />
            <line x1="4" x2="20" y1="6" y2="6" />
            <line x1="4" x2="20" y1="18" y2="18" />
            break;

        case "close":
            // This is for the "X" icon. It is the button that closes the menu on phones.
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
            break;
    }
</svg>