@page

@{
    // This tells the page to use the dashboard layout (the sidebar on the left).
    Layout = "_DashboardLayout";

    // This is for the name on the browser tab. It shows "My Reviewers - Rebyulusyon".
    ViewData["Title"] = "My Reviewers";
}

@* ============================================================
   This file is the My Reviewers PAGE (the page you see at "/MyReviewers").
   It is NOT built yet. It only shows a "coming soon" message, so the link in the sidebar has a page to open.
   Only people who are logged in can open it (the list of protected pages is in Program.cs).
   ============================================================ *@
<section class="app-page">
    <div class="container">
        <p class="eyebrow">Your library</p>
        <h1 class="app-title">My Reviewers</h1>
        <p class="app-sub">The reviewers you created.</p>

        <div class="app-empty">
            <span class="icon-chip tone-red"><partial name="_Icon" model='"book"' /></span>
            <h2>Coming soon</h2>
            <p>The reviewers you create will be listed here, and you will choose which ones are public or private.</p>
            <a class="btn btn-primary btn-sm" href="/Dashboard">Back to dashboard</a>
        </div>
    </div>
</section>