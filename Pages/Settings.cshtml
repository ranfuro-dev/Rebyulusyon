@page

@{
    // This tells the page to use the dashboard layout (the sidebar on the left).
    Layout = "_DashboardLayout";

    // This is for the name on the browser tab. It shows "Settings - Rebyulusyon".
    ViewData["Title"] = "Settings";
}

@* ============================================================
   This file is the Settings PAGE (the page you see at "/Settings").
   It is NOT built yet. It only shows a "coming soon" message, so the link in the sidebar has a page to open.
   Only people who are logged in can open it (the list of protected pages is in Program.cs).
   ============================================================ *@
<section class="app-page">
    <div class="container">
        <p class="eyebrow">Your account</p>
        <h1 class="app-title">Settings</h1>
        <p class="app-sub">Change how Rebyulusyon works for you.</p>

        <div class="app-empty">
            <span class="icon-chip tone-yellow"><partial name="_Icon" model='"settings"' /></span>
            <h2>Coming soon</h2>
            <p>You will change your account and your daily goal here.</p>
            <a class="btn btn-primary btn-sm" href="/Dashboard">Back to dashboard</a>
        </div>
    </div>
</section>