@page

@{
    // This tells the page to use the dashboard layout (the sidebar on the left).
    Layout = "_DashboardLayout";

    // This is for the name on the browser tab. It shows "Progress - Rebyulusyon".
    ViewData["Title"] = "Progress";
}

@* ============================================================
   This file is the Progress PAGE (the page you see at "/Progress").
   It is NOT built yet. It only shows a "coming soon" message, so the link in the sidebar has a page to open.
   Only people who are logged in can open it (the list of protected pages is in Program.cs).
   ============================================================ *@
<section class="app-page">
    <div class="container">
        <p class="eyebrow">Your study</p>
        <h1 class="app-title">Progress</h1>
        <p class="app-sub">See how your studying is going.</p>

        <div class="app-empty">
            <span class="icon-chip tone-blue"><partial name="_Icon" model='"chart"' /></span>
            <h2>Coming soon</h2>
            <p>You will see the cards you reviewed, your streak, and your weekly activity here.</p>
            <a class="btn btn-primary btn-sm" href="/Dashboard">Back to dashboard</a>
        </div>
    </div>
</section>